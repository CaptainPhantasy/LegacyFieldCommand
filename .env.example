# Copy this file to apps/web/.env.local for local development.
# Keep all real values out of version control.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only. This key has administrative privileges.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URLs and browser-origin allowlist
NEXT_PUBLIC_BASE_URL=http://localhost:8765
NEXT_PUBLIC_APP_URL=http://localhost:8765
ALLOWED_ORIGINS=http://localhost:8765,http://localhost:3000

# Optional Stack session bridge
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Optional distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional language-model providers
LLM_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
